#include <windows.h>

1 ICON "@CMAKE_SOURCE_DIR@/assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @HX_VERSION_COMMA@
 PRODUCTVERSION @HX_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hexwright"
            VALUE "FileDescription", "Hexwright single-player game trainer"
            VALUE "FileVersion", "@HX_VERSION@"
            VALUE "InternalName", "Hexwright"
            VALUE "ProductName", "Hexwright"
            VALUE "ProductVersion", "@HX_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
